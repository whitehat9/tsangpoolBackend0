{
  "name": "honda-golaghat-server",
  "version": "1.0.0",
  "description": "Nodejs + TS",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc",
    "start:prod": "npm run build && npm start",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:watch": "nodemon --exec ts-node src/server.ts",
    "server": "nodemon src/server.ts",
    "rag:create-index": "ts-node src/scripts/createVectorIndex.ts",
    "invoice:verify": "ts-node src/scripts/verifyServiceInvoicePdf.ts",
    "invoice:verify:e2e": "ts-node src/scripts/verifyServiceInvoiceImport.ts",
    "invoice:migrate-pending": "ts-node src/scripts/migratePendingStock.ts",
    "visitor:seed": "ts-node src/scripts/seedVisitorCount.ts",
    "admin:seed": "ts-node src/scripts/seedSuperAdmin.ts",
    "sales-report:backfill-customers": "ts-node src/scripts/backfillSalesReportCustomers.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@google-cloud/recaptcha-enterprise": "^6.4.0",
    "@types/pdf-parse": "^1.1.5",
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.6.1",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.4.1",
    "express-validator": "^7.3.0",
    "firebase-admin": "^13.5.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mongoose": "^8.14.0",
    "multer": "^2.0.1",
    "nodemailer": "^8.0.7",
    "pdf-parse": "^1.1.1",
    "typescript": "^5.8.3",
    "winston": "^3.17.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/cors": "^2.8.17",
    "@types/csv-parse": "^1.1.12",
    "@types/express": "^5.0.1",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/lodash": "^4.17.20",
    "@types/mongoose": "^5.11.96",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.2",
    "@types/nodemailer": "^8.0.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
